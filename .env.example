# ==============================================================================
# 🔒 WHATSAPP CRM - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# ⚠️ SECURITY NOTICE:
# 1. Never commit real credentials, passwords, or access tokens to Git.
# 2. Copy this file to '.env' for local development:
#    cp .env.example .env
# 3. For production, inject these variables via secure secret managers 
#    (e.g., AWS Secrets Manager, Doppler, Vault, or Railway/Vercel Envs).
# ==============================================================================

# ------------------------------------------------------------------------------
# 🌐 APPLICATION & SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000/api
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 🔐 AUTHENTICATION & SESSION SECURITY
# ------------------------------------------------------------------------------
# Generate strong 64-character random secrets using: openssl rand -hex 32
JWT_SECRET=replace_with_a_super_secure_random_64_character_string_here
JWT_EXPIRATION_TIME=7d
COOKIE_SECRET=replace_with_another_secure_random_hex_key_here
SESSION_ENCRYPTION_KEY=32_byte_aes_key_for_encrypting_stored_baileys_sessions

# ------------------------------------------------------------------------------
# 🗄️ DATABASE CONFIGURATION (PostgreSQL + Prisma)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=prefer
DATABASE_URL="postgresql://postgres:your_secure_db_password@localhost:5432/whatsapp_crm?schema=public"

# ------------------------------------------------------------------------------
# ⚡ REDIS & RATE LIMITING (Webhook Ingestion & Socket.io)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Webhook and API request rate limits per IP / Phone
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# ------------------------------------------------------------------------------
# 📱 META WHATSAPP CLOUD API CONFIGURATION (Multi-Number Routing)
# ------------------------------------------------------------------------------
# Meta App Credentials from developers.facebook.com
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret_used_for_webhook_signature_verification
META_API_VERSION=v19.0

# Secret token configured in Meta App Dashboard for initial webhook challenge
META_WEBHOOK_VERIFY_TOKEN=create_a_unique_random_verify_token_here

# Meta Permanent System User Access Token (NEVER expose to frontend!)
META_SYSTEM_USER_ACCESS_TOKEN=EAAG...permanent_token_with_whatsapp_business_messaging_scope

# WhatsApp Business Account ID (WABA)
META_WABA_ID=your_waba_account_id

# Regional WhatsApp Phone Number IDs (Assigned inside Meta Business Manager)
# 🇦🇪 Dubai Phone Number (+971 50 XXXXXXX)
META_PHONE_ID_DUBAI=102938475610293
# 🇸🇦 Saudi Arabia Phone Number (+966 50 XXXXXXX)
META_PHONE_ID_SAUDI=203948576102938
# 🇵🇰 Pakistan Phone Number (+92 300 XXXXXXX)
META_PHONE_ID_PAK=304958671203948

# ------------------------------------------------------------------------------
# 📲 QR CODE / BAILEYS MULTI-SESSION ENGINES (Alternative to Meta Cloud API)
# ------------------------------------------------------------------------------
# Path where encrypted session auth files are kept (Must be outside web root!)
QR_SESSION_STORAGE_PATH=./storage/secure_sessions
# Set to 'true' to encrypt stored credentials on disk with SESSION_ENCRYPTION_KEY
QR_SESSION_ENCRYPTION_ENABLED=true

# ------------------------------------------------------------------------------
# ☁️ CLOUD MEDIA STORAGE (Customer Images, PDFs, Voice Notes)
# ------------------------------------------------------------------------------
# Option A: AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=me-central-1
AWS_S3_BUCKET_NAME=whatsapp-crm-media-production

# Option B: Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 💻 VITE CLIENT-SIDE PUBLIC VARIABLES (Safe for Browser Bundle)
# ------------------------------------------------------------------------------
# ⚠️ CAUTION: Only prefix variables with 'VITE_' if they are 100% public.
# NEVER put private tokens, Meta App Secret, or Database URLs with VITE_ prefix!
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
VITE_APP_NAME="AmazFast Multi-Country WhatsApp CRM"
VITE_DEFAULT_COUNTRY=AE
